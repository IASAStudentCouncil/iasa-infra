# Конфіг девопса для scripts/connect-repo.sh.
# Скопіювати:  install -m 600 scripts/deploy.env.example ~/.config/iasa-deploy.env
# і заповнити. У ньому секрети — НЕ комітити заповнену копію.

# Приватний ключ, яким GitHub Actions заходить у контейнери
DEPLOY_SSH_KEY_FILE=~/.ssh/iasa-github-actions

# Сервер ІПСА (порожньо, поки адмін не видав адресу й порти)
DEPLOY_HOST=
CHAMP_SSH_PORT=
PORTAL_SSH_PORT=
BOTS_SSH_PORT=

# Telegram-сповіщення CI (гілка CI BOT)
TG_BOT_TOKEN=
TG_CHAT_ID=-1004308618570
TG_THREAD_ID=2
