# Порти на хості. Номери — за погодженням з адміністратором сервера.
# *_BIND=127.0.0.1 — HTTP-порти доступні тільки nginx на цьому ж сервері (рекомендовано).
# Якщо nginx на іншій машині, поставте 0.0.0.0.

CHAMP_SSH_PORT=20022
CHAMP_HTTP_PORT=20080
CHAMP_HOOK_PORT=20081
CHAMP_BIND=127.0.0.1

PORTAL_SSH_PORT=21022
PORTAL_HTTP_PORT=21080
PORTAL_HOOK_PORT=21081
PORTAL_BIND=127.0.0.1

BOTS_SSH_PORT=22022
# діапазон з 4 портів для вебхуків ботів
BOTS_HOOK_PORTS=22080-22083
BOTS_BIND=127.0.0.1

# Додаткові публічні SSH-ключі (на додачу до keys/*.pub), по одному на рядок
EXTRA_AUTHORIZED_KEYS=
